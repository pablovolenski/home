# systemd unit: copy to /etc/systemd/system/quiz-server.service
# (see README.md → "Option A").
[Unit]
Description=Quick Quiz backend (pablovolenski.com/quiz)
After=network.target

[Service]
Type=simple
User=quiz
WorkingDirectory=/opt/quiz-server
EnvironmentFile=/etc/quiz-server.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=on-failure
RestartSec=5

# Hardening: the process can only write to its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/quiz-server

[Install]
WantedBy=multi-user.target
